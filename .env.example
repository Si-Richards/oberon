# Oberon v0.9.1 - Binance USD-M Futures public market-data research
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,ADAUSDT,DOGEUSDT,AVAXUSDT,LINKUSDT,LTCUSDT
OBERON_DATA_DIR=/data
MARKET_DIR_NAME=markets-v091
FUTURES_WS_BASE_URL=wss://fstream.binance.com
FUTURES_REST_BASE_URL=https://fapi.binance.com
SAMPLE_INTERVAL_MS=1000
DEPTH_LEVELS=20
STALE_MARKET_MS=5000
SQLITE_COMMIT_EVERY=25
SQLITE_BUSY_TIMEOUT_MS=5000

# v0.9.1 is research/paper only. It never submits Binance orders.
RESEARCH_ONLY=true
PAPER_ENABLED=false
PAPER_NOTIONAL=25
PAPER_HALF_SPREAD_BPS=8
PAPER_REQUOTE_SECONDS=5
EXPECTED_ROUND_TRIP_BPS=16.5
HEALTH_MAX_SAMPLE_AGE_SECONDS=30
