# =============================================================================
# Oberon v0.9.1 - complete environment configuration
# Binance USD-M Futures public market-data research / paper simulation only
# =============================================================================

# -----------------------------------------------------------------------------
# Market universe
# -----------------------------------------------------------------------------
# Comma-separated USD-M Futures symbols.
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,ADAUSDT,DOGEUSDT,AVAXUSDT,LINKUSDT,LTCUSDT

# -----------------------------------------------------------------------------
# Binance Futures public endpoints
# -----------------------------------------------------------------------------
FUTURES_WS_BASE_URL=wss://fstream.binance.com
FUTURES_REST_BASE_URL=https://fapi.binance.com

# -----------------------------------------------------------------------------
# Data storage
# -----------------------------------------------------------------------------
# Path inside the container.
OBERON_DATA_DIR=/data

# Generation directory created under OBERON_DATA_DIR.
MARKET_DIR_NAME=markets-v091

# Docker Compose volume name mounted at /data.
# Keep this pointed at the current v0.9.0 data volume if you want v0.9.1 reports
# to be able to inspect the existing history as well as markets-v091.
OBERON_VOLUME_NAME=oberon-market-maker-v090_oberon-data

# -----------------------------------------------------------------------------
# Market-data sampling / depth
# -----------------------------------------------------------------------------
# Minimum supported sample interval is 100 ms.
SAMPLE_INTERVAL_MS=1000

# Supported values: 5, 10, 20.
DEPTH_LEVELS=20

# Treat market state as stale after this many milliseconds.
STALE_MARKET_MS=5000

# -----------------------------------------------------------------------------
# SQLite persistence
# -----------------------------------------------------------------------------
# Commit after this many buffered samples.
SQLITE_COMMIT_EVERY=25

# SQLite busy timeout in milliseconds.
SQLITE_BUSY_TIMEOUT_MS=5000

# -----------------------------------------------------------------------------
# Safety / execution mode
# -----------------------------------------------------------------------------
# v0.9.1 is intentionally research/paper only and does not submit Binance orders.
# This MUST remain true.
RESEARCH_ONLY=true

# Enable the local paper-fill simulator.
PAPER_ENABLED=false

# Nominal notional value used by the paper simulator.
PAPER_NOTIONAL=25

# Quoted half-spread used by the paper simulator, in basis points.
PAPER_HALF_SPREAD_BPS=8

# Paper quote refresh interval, in seconds.
PAPER_REQUOTE_SECONDS=5

# -----------------------------------------------------------------------------
# Research-report economics
# -----------------------------------------------------------------------------
# Expected total round-trip cost used by directional_report when --round-trip-bps
# is not supplied explicitly. Includes the economic hurdle you want the signal
# to overcome; adjust this when your fee assumptions change.
EXPECTED_ROUND_TRIP_BPS=16.5

# -----------------------------------------------------------------------------
# Healthcheck
# -----------------------------------------------------------------------------
# Maximum permitted age of the newest persisted market sample before the
# container healthcheck reports unhealthy.
HEALTH_MAX_SAMPLE_AGE_SECONDS=30

# =============================================================================
# No Binance API key or secret is required by v0.9.1.
# The release consumes public Futures market data and supports local paper
# simulation only. Do not add production trading credentials to this file.
# =============================================================================
